# The dashboard proxies /api/v1/* to the OpsPilot API at runtime (app/api/v1/[...path]/route.ts).
# Where the API lives (read when the dashboard server starts; no rebuild needed):
OPSPILOT_API_ORIGIN=http://127.0.0.1:8000

# Optional: bypass the proxy and call an API on another origin directly from the browser.
# Leave unset for the default same-origin setup (recommended).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
