# OpsPilot AI - environment template (copy to .env; never commit real secrets)

# --- Application ---------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ----------------------------------------------------------------
# Local dev default is SQLite (zero setup). Production MUST use PostgreSQL.
DATABASE_URL=sqlite:///./opspilot.db
# DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot
ENABLE_PGVECTOR=false
#
# Neon (serverless PostgreSQL): paste the connection string from Neon Console -> Connect.
# Use the DIRECT endpoint (host without "-pooler"): this app keeps its own connection pool, sets
# per-session lock timeouts and runs DDL migrations. postgres:// / postgresql:// are accepted as-is.
# DATABASE_URL=postgresql://<user>:<password>@ep-<name>-<id>.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
# ENABLE_PGVECTOR=true              # Neon ships pgvector; enables vector search for document chunks
# DB_POOL_SIZE=5                    # per process (API + each worker); keep the total under your compute's max_connections
# DB_POOL_RECYCLE_SECONDS=300       # Neon suspends idle compute (default 5 min) and drops connections

# --- Workers -----------------------------------------------------------------
WORKER_MODE=thread                  # inline | thread | db | celery   (db: run python -m app.workers.runner; celery requires REDIS_URL)
# REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=4                # in-process pool size (thread mode)
WORKFLOW_MAX_STEPS=50
WORKFLOW_DEFAULT_TIMEOUT_SECONDS=600
JOB_LEASE_SECONDS=120               # a crashed worker's jobs return to the queue after this
BATCH_ITEM_STALE_SECONDS=300        # a bulk-run item stuck "running" this long is reclaimed

# --- Security ------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ALLOW_PASSWORD_LOGIN=true           # set false once OIDC is configured
# OIDC_ISSUER=https://login.example.com/
# OIDC_AUDIENCE=opspilot-api
# OIDC_JWKS_URL=https://login.example.com/.well-known/jwks.json
WEBHOOK_SIGNING_SECRET=             # fallback secret for X-OpsPilot-Signature webhooks (per-integration secrets preferred)
# Password for the seeded demo accounts. Leave unset locally (public default, shown on the login page);
# ALWAYS set it on an internet-facing deployment. Re-running the seed rotates existing demo accounts.
# DEMO_PASSWORD=
RATE_LIMIT_PER_MINUTE=600
APPROVAL_DEFAULT_TTL_HOURS=48

# --- LLM -----------------------------------------------------------------------
LLM_PROVIDER=auto                   # auto (first key found: gemini, anthropic, openai) | mock | anthropic | openai | gemini
# Add one or more keys. With several, OpsPilot fails over between them automatically when one
# is rate-limited, out of quota or down; with none, agents use their built-in logic.
# GEMINI_API_KEY=                   # Google AI Studio key (free tier: ~20 requests/day per model)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_FALLBACK_PROVIDERS=auto       # auto = every other keyed provider | none | e.g. anthropic,openai
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite   # each has its own free quota
# GEMINI_MODEL=gemini-3.6-flash  ANTHROPIC_MODEL=claude-sonnet-5-5  OPENAI_MODEL=gpt-4o   # per-provider defaults
# LLM_DEFAULT_MODEL / LLM_FAST_MODEL override the primary provider's models, e.g. with Gemini:
#   LLM_DEFAULT_MODEL=gemini-3.6-flash  LLM_FAST_MODEL=gemini-3.6-flash  LLM_MAX_OUTPUT_TOKENS=8192
#   (Gemini counts thinking tokens toward the output limit; effort maps to thinking_level)
LLM_DEFAULT_MODEL=claude-opus-5-5
LLM_FAST_MODEL=claude-opus-5-5      # fast tier = same model at lower effort
LLM_EFFORT=medium                   # low | medium | high | xhigh | max
LLM_FAST_EFFORT=low
LLM_ENABLE_FALLBACKS=true           # server-side model fallback on overload
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2048

# --- Ops Copilot / tools / MCP --------------------------------------------------
COPILOT_EFFORT=high
COPILOT_MAX_ITERATIONS=8
COPILOT_MAX_TOOL_CALLS=24
CUSTOM_TOOLS_ALLOW_PRIVATE_NETWORK=false   # keep false: blocks SSRF to internal/metadata addresses
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,testserver   # add your public API host in production

# --- Observability --------------------------------------------------------------
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=opspilot-api
METRICS_ENABLED=true

# --- Documents ------------------------------------------------------------------
DOCUMENT_STORAGE_BACKEND=local      # local | s3
DOCUMENT_STORAGE_PATH=./storage
# S3_BUCKET=
# S3_REGION=
MAX_DOCUMENT_SIZE_MB=25

# --- Frontend -------------------------------------------------------------------
# The dashboard proxies /api/v1/* to this origin (server side), so the browser never needs CORS.
OPSPILOT_API_ORIGIN=http://127.0.0.1:8000
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1   # only to bypass the proxy and call the API directly
